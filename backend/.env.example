# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# PostgreSQL (required; provided by docker-compose.infra.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=fastfood
POSTGRES_USER=fastfood
POSTGRES_PASSWORD=fastfood
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Browser clients (storefront / backoffice)
# ---------------------------------------------------------------------------
# Comma-separated origins. Credentials (session cookies) are sent, so explicit
# origins are required — a wildcard is not allowed.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---------------------------------------------------------------------------
# Cache / Redis (provided by docker-compose.infra.yml)
# ---------------------------------------------------------------------------
# locmem (development default, no Redis server needed) | redis
CACHE_BACKEND=locmem
REDIS_URL=redis://127.0.0.1:6379/0
# Search/autocomplete response caching (seconds). Set ENABLED=False to disable.
CATALOG_SEARCH_CACHE_ENABLED=True
CATALOG_SEARCH_CACHE_TTL=60
CATALOG_SUGGEST_CACHE_ENABLED=True
CATALOG_SUGGEST_CACHE_TTL=120
# Optional JSON object merged with the built-in Persian food synonyms
# CATALOG_SEARCH_SYNONYMS={"برگر": ["همبرگر"], "نوشابه": ["کوکاکولا"]}
# pg_trgm similarity thresholds (0..1) for fuzzy search and "did you mean"
CATALOG_SEARCH_SIMILARITY_THRESHOLD=0.2
CATALOG_DID_YOU_MEAN_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# Staging/production: False (a real worker and beat process are running).
# Set True only when running without workers (tests, single-process demos);
# tasks then execute inline in the web process.
CELERY_TASK_ALWAYS_EAGER=False

# ---------------------------------------------------------------------------
# Payments / SMS
# ---------------------------------------------------------------------------
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=
ZARINPAL_SANDBOX=True

SMS_IR_API_KEY=
SMS_IR_SENDER=

# ---------------------------------------------------------------------------
# Security (only evaluated when DEBUG=False)
# ---------------------------------------------------------------------------
# Keep HTTPS enforcement off for an HTTP-only staging server, then enable all
# four flags once TLS is terminated in front of Django.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Staging seed (optional)
# ---------------------------------------------------------------------------
# Password for the seeded superuser 09120000000. Defaults to Admin1234!.
# STAGING_ADMIN_PASSWORD=Admin1234!
